[
  {
    "table_name": "regions",
    "table_description": "地区表，存储国家、省份、城市、区县等地理层级信息",
    "columns": [
      {"name": "id", "description": "地区唯一标识符，主键", "type": "INT"},
      {"name": "name", "description": "地区名称，不能为空", "type": "VARCHAR(100)"},
      {"name": "parent_id", "description": "上级地区ID，外键关联regions表自身", "type": "INT"},
      {"name": "level", "description": "地区级别枚举值", "type": "ENUM('country','province','city','district')"}
    ]
  },
  {
    "table_name": "addresses",
    "table_description": "用户地址表，存储用户的收货地址信息",
    "columns": [
      {"name": "id", "description": "地址唯一标识符，主键", "type": "INT"},
      {"name": "user_id", "description": "关联的用户ID，外键", "type": "INT"},
      {"name": "region_id", "description": "关联的地区ID，外键", "type": "INT"},
      {"name": "detail", "description": "详细地址", "type": "VARCHAR(255)"},
